# ============================================================================
# AEVRIX Content Intelligence Engine - Environment Configuration
# Copy this file to `.env` and fill in only what you need.
# The app runs in research + manual mode even with most of this left blank.
# NEVER commit your real .env file. NEVER paste employer/company credentials.
# ============================================================================

# ---- Application ----------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Password (plaintext here -> hashed on first dashboard login) for the admin UI
DASHBOARD_PASSWORD=change-me

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/aevrix.db

# ---- LLM provider selection ----------------------------------------------
# One of: foundry | ollama | openai_compatible | gemini | groq
LLM_PROVIDER=ollama
# Leave model blank to use the provider's configured default below.
LLM_MODEL=

# Microsoft Foundry (TEMPORARY provider - do not depend on long term)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-05-01-preview

# Ollama (local fallback - recommended long-term free option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible endpoint (Together, LM Studio, vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to command the bot
TELEGRAM_ALLOWED_USER_IDS=
# Only used in webhook mode (optional). Validates the secret header.
TELEGRAM_WEBHOOK_SECRET=
# polling | webhook
TELEGRAM_MODE=polling

# ---- X (Twitter) API ------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

# ---- LinkedIn API ---------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_API_VERSION=202405

# ---- Optional search API (RSS works without this) -------------------------
# One of: newsdata | tavily | brave | serpapi (leave blank to use RSS only)
# newsdata = NewsData.io free tier (200 credits/day) used as a targeted India/AI
# supplement. ~6 credits per research run, so well within the free limit.
SEARCH_PROVIDER=
SEARCH_API_KEY=
# NewsData.io priority mix (one query = one API request/credit).
# X discovery: 6 India + 2 US + 2 global.
NEWSDATA_TWEET_INDIA_QUERIES_PER_RUN=6
NEWSDATA_TWEET_US_QUERIES_PER_RUN=2
NEWSDATA_TWEET_GLOBAL_QUERIES_PER_RUN=2
# LinkedIn business-case discovery: 7 India + 2 US-with-India-link + 1 global-with-India-link.
NEWSDATA_LINKEDIN_INDIA_QUERIES_PER_RUN=7
NEWSDATA_LINKEDIN_US_QUERIES_PER_RUN=2
NEWSDATA_LINKEDIN_GLOBAL_QUERIES_PER_RUN=1
NEWSDATA_MAX_REQUESTS_PER_RUN=20
# Free plan supports up to 10; paid plans may support up to 50.
NEWSDATA_RESULTS_PER_REQUEST=10
NEWSDATA_QUERY_FIELD=qInTitle
NEWSDATA_API_CATEGORIES=business,technology,top,world
NEWSDATA_TIMEFRAME_HOURS=24
# Optional: top | medium | low. Blank keeps the broadest provider results.
NEWSDATA_PRIORITY_DOMAIN=
NEWSDATA_REMOVE_DUPLICATES=true
# Optional extra query strings separated by | (never put the API key here).
NEWSDATA_INDIA_EXTRA_QUERIES=
NEWSDATA_US_EXTRA_QUERIES=
NEWSDATA_GLOBAL_EXTRA_QUERIES=

# ---- Security -------------------------------------------------------------
# REQUIRED to encrypt OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Secret used to sign Telegram callback tokens and OAuth state
APP_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Cost & behaviour limits ---------------------------------------------
MAX_ARTICLES_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=20
MAX_X_POSTS_PER_DAY=3
MAX_LINKEDIN_POSTS_PER_WEEK=4
RESEARCH_WINDOW_HOURS=24
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
