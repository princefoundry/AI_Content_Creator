# ============================================================================
# AEVRIX - PRODUCTION .env for Oracle Cloud VM
# Copy to /opt/aevrix/.env and fill in. Replace aevrix.example.com everywhere
# with YOUR domain. NEVER commit this file with real secrets.
# ============================================================================

# ---- Application ----------------------------------------------------------
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
DASHBOARD_PASSWORD=change-me-strong

# ---- Database (persistent disk on the VM) ---------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/aevrix.db

# ---- LLM provider: Azure Foundry GPT-5.x via v1 OpenAI-compatible surface --
# Your adapter maps this to ChatOpenAI + base_url + api-key header.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
OPENAI_COMPATIBLE_BASE_URL=https://altsight-openai.openai.azure.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-5.4

# ---- Telegram (bot must stay up 24/7 for approvals) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=1158940857
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling

# ---- X (Twitter) API ------------------------------------------------------
# NOTE: callback is now HTTPS on your domain, not localhost.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://aevrix.example.com/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

# ---- LinkedIn API ---------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://aevrix.example.com/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_API_VERSION=202405

# ---- Optional search API (NewsData.io India/AI booster) -------------------
# Set SEARCH_PROVIDER=newsdata and paste your free NewsData.io key to add a
# targeted India/AI supplement (~6 credits/run, free tier is 200/day).
SEARCH_PROVIDER=
SEARCH_API_KEY=
NEWSDATA_INDIA_QUERIES_PER_RUN=4
NEWSDATA_US_QUERIES_PER_RUN=2
NEWSDATA_GLOBAL_QUERIES_PER_RUN=2
NEWSDATA_MAX_REQUESTS_PER_RUN=8
NEWSDATA_RESULTS_PER_REQUEST=10
NEWSDATA_PRIORITY_DOMAIN=
NEWSDATA_REMOVE_DUPLICATES=true
NEWSDATA_INDIA_EXTRA_QUERIES=
NEWSDATA_US_EXTRA_QUERIES=
NEWSDATA_GLOBAL_EXTRA_QUERIES=

# ---- Security (REQUIRED) --------------------------------------------------
# Generate once and keep stable; losing APP_ENCRYPTION_KEY invalidates stored
# OAuth tokens. Reuse the SAME values you already have working locally.
APP_ENCRYPTION_KEY=
APP_SESSION_SECRET=

# ---- Cost & behaviour limits ----------------------------------------------
MAX_ARTICLES_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=20
MAX_X_POSTS_PER_DAY=3
MAX_LINKEDIN_POSTS_PER_WEEK=4
RESEARCH_WINDOW_HOURS=24
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
